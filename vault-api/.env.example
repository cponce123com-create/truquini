# Entorno: "development" en local, "production" en Render.
# En desarrollo la cookie no lleva Secure para permitir http://localhost.
NODE_ENV=development

# Database
# Set to "sqlite" for local development, or "neon" (default) for Render/Neon Postgres
DB_TYPE=sqlite

# Only needed when DB_TYPE=neon
# DATABASE_URL=postgresql://...

# Proxies de confianza delante de la API (Render = 1).
# Sin esto, el rate limiting usa la IP del proxy y no la del cliente.
TRUST_PROXY=1

JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-64-bytes
FRONTEND_ORIGIN=http://localhost:3000

# Déjalo en false. Ponlo en true solo para crear el usuario inicial.
ALLOW_REGISTRATION=false
PORT=3000
